# Copy to .env and change values. Never commit .env.

# ---- Docker Compose (docker compose up) ------------------------------------------------
POSTGRES_PASSWORD=change-me-db-password
# Must be random and at least 32 characters: the app refuses to start in production otherwise.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# none | reference | demo | benchmark | scenario  (scenario = benchmark run through SCENARIO_UNTIL)
SEED=scenario
SCENARIO_UNTIL=3
SEED_DEMO_PASSWORD=Demo@1234
APP_PORT=8000

# ---- Local development (backend/.env) ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://ota:ota_password@localhost:5432/order_to_audit
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
